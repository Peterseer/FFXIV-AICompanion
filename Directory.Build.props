<Project>
  <!-- 本地开发优先使用环境变量 DALAMUD_HOME；否则按常见安装路径自动探测 -->
  <PropertyGroup Condition="'$(DALAMUD_HOME)' == ''">
    <_DalamudCn>$(USERPROFILE)\AppData\Roaming\XIVLauncherCN\addon\Hooks\dev</_DalamudCn>
    <_DalamudIntl>$(APPDATA)\XIVLauncher\addon\Hooks\dev</_DalamudIntl>
    <DALAMUD_HOME Condition="Exists('$(_DalamudCn)\Dalamud.dll')">$(_DalamudCn)</DALAMUD_HOME>
    <DALAMUD_HOME Condition="'$(DALAMUD_HOME)' == '' and Exists('$(_DalamudIntl)\Dalamud.dll')">$(_DalamudIntl)</DALAMUD_HOME>
  </PropertyGroup>
</Project>
